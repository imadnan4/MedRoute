# MedRoute Configuration — Copy to backend/.env and fill in your values
# All variables are prefixed with MEDROUTE_ (see backend/config.py).
# For Heroku, set these via `heroku config:set` (do NOT commit secrets).

# ----- LLM inference (REQUIRED for live triage) -----
# OpenRouter API key from https://openrouter.ai/settings/keys
MEDROUTE_OPENROUTER_API_KEY=
# Model ID; default free router is for testing only
MEDROUTE_OPENROUTER_MODEL=openrouter/free

# ----- ASR (voice transcription) -----
# auto | local | remote | hf | groq
#   auto  -> groq if MEDROUTE_GROQ_API_KEY set, else local Whisper / HF / remote
#   local -> local faster-whisper (needs GPU/RAM + cached model — not for Heroku)
#   remote-> HTTP NeMo server at MEDROUTE_ASR_SERVER_URL
#   hf    -> HuggingFace hosted Inference API (no local GPU/RAM)
#   groq  -> Groq Whisper (whisper-large-v3-turbo), needs MEDROUTE_GROQ_API_KEY
# Recommended for hosted deployment: MEDROUTE_ASR_MODE=groq
MEDROUTE_ASR_MODE=groq
# Groq Whisper credentials (https://console.groq.com/keys)
MEDROUTE_GROQ_API_KEY=
MEDROUTE_GROQ_ASR_MODEL=whisper-large-v3-turbo
# HuggingFace ASR model used when asr_mode=hf
MEDROUTE_HF_ASR_MODEL=openai/whisper-large-v3
# Optional remote NeMo server (only used when asr_mode=remote)
MEDROUTE_ASR_SERVER_URL=

# ----- Ollama for local LLM inference (unused on Heroku) -----
MEDROUTE_OLLAMA_BASE_URL=http://localhost:11434

# ----- Fireworks AI for remote LLM inference (unused on Heroku) -----
MEDROUTE_FIREWORKS_API_KEY=

# ----- WHO ICD-11 API (free token from https://id.who.int/) -----
MEDROUTE_ICD_API_KEY=

# ----- HuggingFace (optional, speeds up model downloads / HF ASR) -----
MEDROUTE_HF_TOKEN=

# ----- Server (Heroku overrides host/port via $PORT) -----
MEDROUTE_HOST=0.0.0.0
MEDROUTE_PORT=8000
